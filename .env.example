# .env.example — NewsFeed Google AI
# Copy to .env and fill in real values.
# Credentials are in ../GLOBAL_RULES.md — never commit real keys here.

# ─── AI Provider (IBM watsonx — PRIMARY) ─────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_REGION=us-south
WATSONX_TEXT_MODEL=ibm/granite-3-8b-instruct

# ─── AI Provider (Google Gemini — FALLBACK) ──────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=15000

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ─── Data ────────────────────────────────────────────────────────────────────
